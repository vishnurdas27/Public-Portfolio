# Absolute URL of the deployed site, no trailing slash (e.g. https://vishnurdas.dev).
# When set, the build emits canonical + Open Graph image URLs and a sitemap.xml.
VITE_SITE_URL=

# Optional: a Web3Forms access key (https://web3forms.com). When set, the contact form delivers
# messages directly; when empty it opens the visitor's mail app with the message pre-filled.
VITE_WEB3FORMS_KEY=
