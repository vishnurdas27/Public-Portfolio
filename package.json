{
  "name": "vishnu-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio of Vishnu R Das: a personal story site and a recruiter view, built with React and React Router.",
  "scripts": {
    "dev": "react-router dev",
    "validate": "tsx scripts/validate-content.ts",
    "build": "npm run validate && react-router typegen && react-router build && node scripts/postbuild.mjs && tsx scripts/generate-og.mjs",
    "preview": "serve build/client -l 4173 --no-clipboard",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint app scripts tests",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "portraits": "node scripts/build-portraits.mjs",
    "scrapbook": "node scripts/build-scrapbook.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "cmdk": "^1.1.1",
    "isbot": "^5.1.36",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9",
    "@fontsource/geist": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "satori": "^0.34.1",
    "serve": "^14",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8",
    "vite": "^8.0.3",
    "zod": "^4.6.5"
  }
}
